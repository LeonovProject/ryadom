{
  "name": "ryadom",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.23.1 || ^24.19.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "generate:api:ts": "openapi-typescript packages/contracts/openapi.yaml -o packages/api-client/src/schema.d.ts",
    "generate:api": "python3 scripts/generate_api.py",
    "check:generated": "python3 scripts/generate_api.py --check",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @ryadom/web build",
    "check:repository": "python3 scripts/check_repository.py",
    "check:contracts": "python3 scripts/check_api_contract.py"
  },
  "devDependencies": {
    "openapi-typescript": "7.6.1",
    "typescript": "5.9.3",
    "@types/node": "22.19.3",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "swagger-ui-dist": "5.34.0"
  }
}
