# Local HTTP only. For a network address use infra/compose.https.yaml and HTTPS.
WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_ORIGIN=http://127.0.0.1:8080
# Change both if this private Docker subnet conflicts with another local network.
BACKEND_SUBNET=172.30.18.0/24
PROXY_BACKEND_IP=172.30.18.10
COOKIE_SECURE=false

POSTGRES_USER=ryadom
POSTGRES_DB=ryadom
# Generate 32 random bytes as hex, e.g. openssl rand -hex 32. No default password.
POSTGRES_PASSWORD=
# Hex passwords need no URL escaping. URL-encode other password characters.
DATABASE_URL=postgres://ryadom:${POSTGRES_PASSWORD}@db:5432/ryadom?sslmode=disable

# Generate once: openssl rand -base64 32. Keep the same key on normal restarts.
# Never put the actual key into source files, images, web variables or logs.
AUTH_JWT_SECRET=

# HTTPS override, when used; absolute paths to readable certificate/key files.
# WEB_TLS_PORT=8443
# TLS_CERT_PATH=/absolute/path/fullchain.pem
# TLS_KEY_PATH=/absolute/path/privkey.pem
